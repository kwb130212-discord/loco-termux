# Kakao OAuth app credentials (do NOT put your Kakao account password here)
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional room filter
TARGET_ROOM=

# Command prefix
PREFIX=!

# Discord bridge (keep the token private; use the same value in both services)
LOCO_BRIDGE_TOKEN=
LOCO_BRIDGE_HOST=127.0.0.1
LOCO_BRIDGE_PORT=8787
# Optional persistent storage path, for example /var/data/loco-termux on Render
LOCO_DATA_DIR=
