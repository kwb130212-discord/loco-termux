{
  "name": "loco-termux-bot",
  "version": "1.6.6",
  "private": true,
  "description": "Termux Android LOCO bridge with pinned KakaoForge transport and analyzer state layer",
  "main": "dist/termux-panel.js",
  "scripts": {
    "build": "tsc",
    "build:kakaoforge": "node scripts/build-kakaoforge.cjs",
    "doctor:loco": "node scripts/check-loco-transport.cjs",
    "prepare": "npm run build:kakaoforge",
    "start": "node dist/termux-panel.js",
    "start:panel": "node dist/termux-panel.js",
    "start:core": "node dist/bridge-main.js",
    "start:safe": "bash 실행.sh",
    "start:loco": "node dist/index.js",
    "start:openchat": "node dist/openchat-main.js",
    "openchat:qr": "node dist/qr-login.js",
    "login:qr": "node dist/qr-login.js",
    "login:loco": "node dist/qr-login.js",
    "rooms": "python3 방관리_cli.py rooms",
    "room:add": "python3 방관리_cli.py add",
    "room:enable": "python3 방관리_cli.py enable",
    "room:disable": "python3 방관리_cli.py disable",
    "room:remove": "python3 방관리_cli.py remove",
    "room:members": "python3 방관리_cli.py members",
    "room:readers": "python3 방관리_cli.py readers",
    "room:export": "python3 방관리_cli.py export",
    "room:departed-export": "python3 방관리_cli.py departed-export",
    "dev": "tsx src/index.ts"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "dotenv": "^16.4.7",
    "kakaoforge": "git+https://github.com/minjaemin2020/KakaoForge.git#4b774ea40b1347280fadb685415436584093118b",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
